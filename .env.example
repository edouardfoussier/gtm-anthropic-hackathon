# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=            # hackathon credits ($100/participant)
SILLAGE_MCP_URL=              # MCP transport — handed at kickoff (either this or SILLAGE_API_KEY enables the real adapter)
SILLAGE_API_KEY=              # V2 API transport — key from getsillage.com app settings
FULLENRICH_API_KEY=           # Bearer, from app.fullenrich.com/app/api
GAMMA_API_KEY=                # X-API-KEY header
GRADIUM_API_KEY=              # promo code GTM-HACK
GRADIUM_VOICE_ID=             # cloned voice id
FAL_KEY=
RESEND_API_KEY=
EMAIL_FROM=                   # verified sender
APP_URL=http://localhost:3000 # or the tunnel/Vercel URL for live email links

# Extra cloned voices (presenter select maps to these)
EDOUARD_VOICE_ID=
MATHIS_VOICE_ID=

# Outbound callback — gtm-hack call-spike (Twilio ConversationRelay) base URL.
# When set + phone is E.164, "Get contacted" places a real call. Inert until set.
CALL_SPIKE_URL=
